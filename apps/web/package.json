{
  "name": "@cmp/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web app product slice consuming @cmp/utils",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "dev": "tsc -w -p tsconfig.build.json",
