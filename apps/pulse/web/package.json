{
  "name": "pulse-web",
  "version": "0.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "lint": "node scripts/lint-angular.mjs",
    "typecheck": "tsc --noEmit",
    "build": "ng build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ../contracts/pulse-api.openapi.json -o src/app/api/generated/pulse-api.types.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@playwright/test": "^1.65.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "glob": ">=14.0.6",
    "minimatch": ">=11.0.8"
  }
}
