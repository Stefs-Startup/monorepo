{
  "name": "cmp-root",
  "version": "0.0.0",
  "private": true,
  "description": "Company of One \u2014 monorepo root. All apps, packages, and infrastructure live here.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rimraf node_modules",
    "check": "scripts/check.sh --changed",
    "check:all": "scripts/check.sh --all",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@techdocs/cli": "^1.14.0",
    "lefthook": "^2.2.2",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.10"
  }
}
