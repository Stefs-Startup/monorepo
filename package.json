{
  "name": "cmp-root",
  "version": "0.0.0",
  "private": true,
  "description": "Company of One \u2014 monorepo root. All apps, packages, and infrastructure live here.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rimraf node_modules",
    "gen:app": "node packages/factory/dist/src/cli.js gen:app",
    "gen:slice": "node packages/factory/dist/src/cli.js gen:slice",
    "verify:slice": "node packages/factory/dist/src/cli.js verify",
    "plan:critic": "node packages/factory/dist/src/cli.js plan:critic",
    "scorecard": "node packages/factory/dist/src/cli.js scorecard",
    "blast-radius": "node tools/blast-radius/dist/src/cli.js",
    "arch:check": "NODE_PATH=packages/factory/node_modules npx --yes dependency-cruiser --config .dependency-cruiser.cjs packages apps/web",
    "mutation:test": "npx --yes @stryker-mutator/core run",
    "check": "scripts/check.sh --changed",
    "check:all": "scripts/check.sh --all",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.13",
      "glob": ">=14.0.6",
      "lodash": ">=4.18.1",
      "lodash-es": ">=4.18.1",
      "minimatch": ">=11.0.8"
    }
  }
}
