package com.cmp.service.api;

import com.cmp.service.domain.ServiceStatusEngine;
import com.cmp.service.domain.ServiceStatusEngine.ServiceStatusSnapshot;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.models.OpenAPI;
import io.swagger.v3.oas.models.info.Info;
import org.springframework.context.annotation.Bean;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class ServiceStatusController {

    @Bean
    public OpenAPI serviceOpenApi() {
        return new OpenAPI()
                .info(new Info()
                        .title("{{pascalCase name}} Service API")
                        .version("0.1.0")
                        .description("Contract-first OpenAPI 3.1.0 specification for {{dashCase name}}."));
    }

    @GetMapping("/api/v1/status")
    @Operation(operationId = "getServiceStatus", summary = "Returns current service health and metadata")
    public ServiceStatusSnapshot getStatus() {
        return ServiceStatusEngine.evaluateStatus("{{dashCase name}}");
    }
}
